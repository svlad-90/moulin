ninja_required_version = 1.10
rule regenerate
  command = moulin.py $
      /home/vladyslav_goncharuk/Projects/new_dev/moulin-svlad-90/tests/integration_tests/zephyr_builder/test_build_dependencies/tmpxe4aauwv/build.yaml
  generator = 1

build build.ninja: regenerate $
    /home/vladyslav_goncharuk/Projects/new_dev/moulin-svlad-90/tests/integration_tests/zephyr_builder/test_build_dependencies/tmpxe4aauwv/build.yaml

rule rouge
  command = rouge $
      /home/vladyslav_goncharuk/Projects/new_dev/moulin-svlad-90/tests/integration_tests/zephyr_builder/test_build_dependencies/tmpxe4aauwv/build.yaml $
      -fi $image_name -o $out

rule gzip
  command = command -v pigz > /dev/null 2>&1 && pigz -1kf $in || gzip -1kf $in

rule bmaptool
  command = bmaptool create $in -o $out

rule zephyr_build
  command = bash -c "( cd $build_dir && source zephyr/zephyr-env.sh && $env west build -p auto -b $board -d $work_dir $
      $target $snippets -- $shields $vars ) && moulin.py $
      /home/vladyslav_goncharuk/Projects/new_dev/moulin-svlad-90/tests/integration_tests/zephyr_builder/test_build_dependencies/tmpxe4aauwv/build.yaml $
      --dep $name"
  description = Invoke Zephyr build system
  depfile = .moulin_$name.d
  pool = console
  restat = 1
  deps = gcc

build fetch-test: phony

build workspace/build/zephyr/zephyr.bin: zephyr_build
  name = test
  build_dir = workspace
  board = native_sim
  target = app
  work_dir = build
  shields = 
  snippets = 
  vars = 
  env = 

build test: phony workspace/build/zephyr/zephyr.bin

default test
